{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "configurationEnv", "pipelineClass"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "configurationEnv": {
      "const": "RESOURCE_PIPELINE_CONFIG"
    },
    "pipelineClass": {
      "enum": ["production", "validation", "retained"]
    },
    "dailyScheduled": {
      "type": "boolean",
      "default": false
    }
  }
}
