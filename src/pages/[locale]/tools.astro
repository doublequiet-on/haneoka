---
import { staticBuildPaths } from "../../server/static-build";
import HubDocument from "../../components/HubDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/tools.astro", LOCALES.map(locale => ({ params: { locale } })));
}
const { locale } = Astro.params as { locale: Locale };
---
<HubDocument id="tools" locale={locale} />
