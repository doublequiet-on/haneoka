---
import { staticBuildPaths } from "../../../server/static-build";
import HubDocument from "../../../components/HubDocument.astro";
import CommunityDocument from "../../../components/CommunityDocument.astro";
import { LOCALES, type Locale } from "../../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/[...path].astro", LOCALES.flatMap((locale) =>
    [undefined, "feeds", "latest", "following", "mine", "bookmarks", "notifications", "activity", "tags", "playlists", "forums"].map((path) => ({
      params: { locale, path },
      props: { locale, path },
    })),
  ));
}
const { locale, path } = Astro.props as { locale: Locale; path?: string };
---
{path ? <CommunityDocument locale={locale} path={path} /> : <HubDocument id="community" locale={locale} />}
<script>
  const preserveFeedQuery = () => {
    if (!/^\/[^/]+\/community\/?$/u.test(location.pathname)) return;
    const query = new URLSearchParams(location.search);
    if (["q", "tag", "tags", "scope", "forumId", "state"].some(key => query.has(key))) {
      location.replace(`${location.pathname.replace(/\/$/u, "")}/feeds/${location.search}${location.hash}`);
    }
  };
  preserveFeedQuery();
  document.addEventListener("astro:page-load", preserveFeedQuery);
</script>
