---
import { staticBuildPaths } from "../../../../server/static-build";
import CommunityChartsDocument from "../../../../components/CommunityChartsDocument.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/charts/index.astro", LOCALES.map((locale) => ({ params: { locale } })));
}
const locale = Astro.params.locale as Locale;
---
<CommunityChartsDocument locale={locale} server="intl" />
