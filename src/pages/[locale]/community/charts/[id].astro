---
import { staticBuildPaths } from "../../../../server/static-build";
import CommunityChartEntityPage from "../../../../components/entities/CommunityChartEntityPage.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/charts/[id].astro", LOCALES.map((locale) => ({ params: { locale, id: "_" } })));
}
const locale = Astro.params.locale as Locale;
---
<CommunityChartEntityPage locale={locale} server="intl" />
