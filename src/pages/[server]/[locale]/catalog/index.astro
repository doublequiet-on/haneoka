---
import { staticBuildPaths } from "../../../../server/static-build";
import HubDocument from "../../../../components/HubDocument.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { type ReleaseServer } from "../../../../lib/release-server";
import { staticCatalogPageServers } from "../../../../lib/entity-graph";

export async function getStaticPaths() {
  return staticBuildPaths("src/pages/[server]/[locale]/catalog/index.astro", (await staticCatalogPageServers()).flatMap((server) => LOCALES.map((locale) => ({ params: { server, locale } }))));
}

const { server, locale } = Astro.params as { server: ReleaseServer; locale: Locale };
---
<HubDocument id="catalog" locale={locale} server={server} />
