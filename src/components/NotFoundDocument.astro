---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";

const { locale } = Astro.props as { locale: Locale };
const titleKey = "common.errors.page.notFoundTitle";
const title = t(locale, titleKey, "Page not found");
---

<Base locale={locale} route="/404" title={title} titleKey={titleKey}>
  <AppShell locale={locale} route="/404" title={title} titleKey={titleKey}>
    <section class="page">
      <div class="notice">
        <span class="notice__icon"><Icon name="search_off" size={36} /></span>
        <h2><I18nText keyName={titleKey} fallback="Page not found" locale={locale} /></h2>
        <a class="button button--tonal" href="/">
          <I18nText keyName="common.errors.page.backHome" fallback="Back to home" locale={locale} />
        </a>
      </div>
    </section>
  </AppShell>
</Base>
