---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import { communityChartPath } from "../lib/community-chart-route";
import "../styles/patterns/chart.css";
import "../styles/community-charts.css";
interface Props { locale: Locale; server: string }
const { locale, server } = Astro.props;
const titleKey = "community.charts.title";
const title = t(locale, titleKey);
---
<Base locale={locale} route="/community/charts" title={title} titleKey={titleKey} canonicalRoute={communityChartPath(server, locale)}>
  <AppShell locale={locale} server={server} route="/community/charts" title={title} titleKey={titleKey}>
    <community-charts locale={locale} server={server} class="community-charts page"></community-charts>
  </AppShell>
</Base>
<script>import "../lit/community-charts";</script>
